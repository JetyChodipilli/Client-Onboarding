# Development/test S3 fixture built from the upstream security release.
FROM golang:1.26-alpine AS build
RUN CGO_ENABLED=0 go install -trimpath github.com/minio/minio@RELEASE.2025-10-15T17-29-55Z
RUN cp /go/pkg/mod/github.com/minio/minio@*/LICENSE /tmp/LICENSE

FROM alpine:3.23
RUN apk add --no-cache ca-certificates curl && mkdir /data && chown 10001:10001 /data
COPY --from=build /go/bin/minio /usr/local/bin/minio
COPY --from=build /tmp/LICENSE /usr/share/licenses/minio/LICENSE
USER 10001:10001
EXPOSE 9000
ENTRYPOINT ["minio"]
CMD ["server", "/data"]
