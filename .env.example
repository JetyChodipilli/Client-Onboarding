COMPOSE_PROJECT_NAME=client-onboarding
POSTGRES_DB=client_onboarding
POSTGRES_USER=client_onboarding
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=jdbc:postgresql://postgres:5432/client_onboarding?currentSchema=app
DATABASE_USERNAME=client_onboarding
DATABASE_PASSWORD=local-development-only
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_ASSET_STORAGE_ORIGIN=http://localhost:9000
# Development S3 only; production requires private versioned storage and dedicated IAM credentials.
MINIO_ROOT_USER=local-storage-admin
MINIO_ROOT_PASSWORD=local-storage-admin-change-me
ASSET_STORAGE_ENABLED=true
ASSET_STORAGE_ENDPOINT=http://localhost:9000
ASSET_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
ASSET_STORAGE_BUCKET=onboarding-assets
ASSET_STORAGE_ACCESS_KEY=onboarding-app
ASSET_STORAGE_SECRET_KEY=local-asset-app-change-me
ASSET_SCANNER_HOST=localhost
ASSET_SCANNER_PORT=3310
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_DURATION=8h
SESSION_IDLE_TIMEOUT=30m
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m
SECURITY_TOKEN_DURATION=30m
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SECURITY_MAIL_FROM=no-reply@example.test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_AUTH=false
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_ORGANIZATION_NAME=
APP_BOOTSTRAP_ORGANIZATION_SLUG=
APP_BOOTSTRAP_ADMIN_NAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
