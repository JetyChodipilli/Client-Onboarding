SECURITY_MAIL_FROM=no-reply@example.test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_AUTH=false
APP_BOOTSTRAP_ENABLED=false
