POSTGRES_DB=client_onboarding
POSTGRES_USER=client_onboarding
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

BACKEND_PORT=8080

# Database/query-performance tuning. Start with these conservative defaults and size the pool from
# measured concurrency; do not increase pool size blindly because PostgreSQL connections are finite.
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_PREPARED_STATEMENT_CACHE_QUERIES=256
DB_PREPARED_STATEMENT_CACHE_MIB=5
DB_PREPARE_THRESHOLD=3
HIBERNATE_DEFAULT_BATCH_FETCH_SIZE=50
HIBERNATE_JDBC_BATCH_SIZE=25
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
APP_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_API_DOCS=true
SECURE_COOKIES=false

# Generate secrets locally; never commit real values:
#   openssl rand -base64 64   # APP_AUTH_JWT_SECRET_BASE64
#   openssl rand -base64 32   # APP_AUTH_MFA_ENCRYPTION_KEY_BASE64
APP_AUTH_JWT_SECRET_BASE64=
APP_AUTH_MFA_ENCRYPTION_KEY_BASE64=
APP_REQUIRE_EXPLICIT_SECRETS=false

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@local.test
FRONTEND_BASE_URL=http://localhost:3000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Optional one-time first-tenant bootstrap. If enabled, provide every field and use a strong password.
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_ORGANIZATION_NAME=
APP_BOOTSTRAP_ORGANIZATION_SLUG=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Phase 6 object storage. Use separate credentials in production and rotate them through your secrets manager.
ASSET_STORAGE_ENABLED=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=client-onboarding-assets
S3_ACCESS_KEY=minio-local
S3_SECRET_KEY=change-me-minio-local
S3_PATH_STYLE_ACCESS=true
S3_UPLOAD_URL_TTL=15m
S3_DOWNLOAD_URL_TTL=10m

# Malware scanning is fail-closed: files are never downloadable/reviewable until a clean scan completes.
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT=5s
CLAMAV_READ_TIMEOUT=2m
MALWARE_SCAN_MAX_ATTEMPTS=5
MALWARE_SCAN_POLL_DELAY=10s
MALWARE_SCAN_BATCH_SIZE=10
MALWARE_SCAN_RETRY_BASE_DELAY=30s
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio-local
MINIO_ROOT_PASSWORD=change-me-minio-local

# Phase 7 payment provider. SIGNED_SANDBOX is local/test only; production should configure a real adapter.
PAYMENT_PROVIDER=SIGNED_SANDBOX
# openssl rand -base64 32
PAYMENT_WEBHOOK_SECRET_BASE64=
PAYMENT_CHECKOUT_BASE_URL=http://localhost:3000/portal/payments/sandbox
PAYMENT_WEBHOOK_MAX_AGE=5m
PAYMENT_SESSION_TTL=30m
PAYMENT_MAX_WEBHOOK_BYTES=262144
PAYMENT_OVERDUE_SCAN_DELAY=5m

# Phase 8 e-signatures. SIGNED_SANDBOX is local/test only; production requires a real provider adapter.
CONTRACT_PROVIDER=SIGNED_SANDBOX
# openssl rand -base64 32
CONTRACT_WEBHOOK_SECRET_BASE64=
CONTRACT_SIGNING_BASE_URL=http://localhost:3000/portal/contracts/sandbox
CONTRACT_WEBHOOK_MAX_AGE=5m
CONTRACT_MAX_WEBHOOK_BYTES=262144
CONTRACT_MAX_SIGNED_DOCUMENT_BYTES=20971520
CONTRACT_STORAGE_ENABLED=true
CONTRACT_S3_BUCKET=client-onboarding-contracts
CONTRACT_S3_DOWNLOAD_URL_TTL=10m
